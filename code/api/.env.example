APP_ENV=loc
PORT=3001

DB_HOST=localhost
DB_PORT=5432
DB_NAME=myhobbees_loc
DB_USERNAME=myhobbees
DB_PASSWORD=myhobbees
DB_SSLMODE=disable

JWT_SECRET=local-dev-secret-at-least-32-characters

# Exactement 32 octets (AES-256-GCM), distinct de JWT_SECRET.
# ex. openssl rand -base64 24 | cut -c1-32
CREDENTIAL_SHARE_SECRET=

SHOPIFY_STORE_DOMAIN=
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=

# Bootstrap-only: read a single time, to create the first super-admin row
# in the admins table, and only while that table is still empty. Once any
# admin exists (bootstrapped or created via the back-office), these two
# vars are never read again — login checks the admins table, not them.
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=''

POSTHOG_PERSONAL_API_KEY=
POSTHOG_PROJECT_ID=
POSTHOG_HOST=https://eu.posthog.com
