SESSION_SECRET="change-me-with-a-long-random-string"

PUBLIC_STORE_DOMAIN=""

PUBLIC_STOREFRONT_API_TOKEN=""
PUBLIC_STOREFRONT_ID=""

PUBLIC_CHECKOUT_DOMAIN=""

# Canonical production host used to build absolute SEO URLs (canonical link,
# og:url, JSON-LD url). Pins the host so a crawler reaching the site via a
# Vercel preview/alias domain doesn't self-endorse that domain as canonical.
# Falls back to the request's own origin when unset, so local dev works as-is.
PUBLIC_SITE_URL=""

PUBLIC_POSTHOG_KEY=""
PUBLIC_POSTHOG_HOST=""

# Go API base URL, server-only (never exposed to the client bundle). Local API: http://localhost:3001
API_BASE_URL=""

# Required by Hydrogen's HydrogenEnv type; only needed if Customer Account API login is used.
PRIVATE_STOREFRONT_API_TOKEN=""
PUBLIC_CUSTOMER_ACCOUNT_API_CLIENT_ID=""
PUBLIC_CUSTOMER_ACCOUNT_API_URL=""
SHOP_ID=""
